{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casa-brasa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Keep variables added in the Cloudflare dashboard across deploys
  "keep_vars": true,
  // Wrangler's __name() helpers break server functions inlined as <script>
  "keep_names": false,
  // Non-secret settings; secrets are set in the Cloudflare dashboard
  "vars": {
    "WHATSAPP_BRIDGE_URL": "https://casa-brasa-wa.onrender.com"
  }
}
