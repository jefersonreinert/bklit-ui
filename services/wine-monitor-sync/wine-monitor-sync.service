[Unit]
Description=Wine Monitor (By The Glass) -> Casa Brasa POS read-only sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/wine-monitor-sync
EnvironmentFile=/etc/wine-monitor-sync.env
ExecStart=/usr/bin/node /opt/wine-monitor-sync/sync.mjs
TimeoutStartSec=600
Nice=10
